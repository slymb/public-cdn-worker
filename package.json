{
  "name": "public-cdn-worker",
  "version": "1.0.2",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "prod:offline": "wrangler dev --local --config wrangler.toml",
    "prod:local": "wrangler dev --remote --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "check": "wrangler deploy --dry-run --config wrangler.toml",
    "tail": "wrangler tail --config wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.90.0"
  }
}
