# ===================================================
# PUBLIC CDN WORKER - DASHBOARD VARIABLES
# ===================================================
#
# Standard:
# - Configure these values in Cloudflare Dashboard.
# - Do not declare runtime variables in wrangler.toml.
# - Keep keep_vars = true in wrangler.toml.
# - Never commit real secrets.


# ===================================================
# REQUIRED
# ===================================================

# Allowed domains, comma-separated.
ALLOWED_DOMAINS=cdn.example.com,example.com,www.example.com

# Source bucket base URL, no trailing slash.
# Cloudflare type: Secret.
B2_ENDPOINT=https://f001.backblazeb2.com/file/YOUR_BUCKET


# ===================================================
# RECOMMENDED PROTECTION
# ===================================================

BLOCK_DIRECT_MEDIA_ACCESS=true
BLOCK_CROSS_SITE_NO_REFERRER=true
BLOCK_SUSPICIOUS_MEDIA_REQUESTS=true
BLOCK_MEDIA_INDEXING=true
BLOCK_EMPTY_UA=true
BLOCKED_USER_AGENTS=python,requests,curl,wget,axios,scrapy,craw


# ===================================================
# OPTIMIZATION AND DISPLAY
# ===================================================

USE_MEDIA_WRAPPER=true
ENABLE_WEBP=true
IMAGE_QUALITY=50
MAX_WIDTH=1200
MAIN_SITE_DOMAIN=example.com
SITE_NAME=example.com
SITE_URL=https://example.com


# ===================================================
# OPTIONAL SIGNED URLS
# ===================================================

REQUIRE_SIGNED_URLS=false

# Cloudflare type: Secret.
# Required only when REQUIRE_SIGNED_URLS=true.
SIGNING_SECRET=replace-with-cloudflare-secret

SIGNATURE_PARAM=sig
EXPIRES_PARAM=exp


# ===================================================
# OPTIONAL
# ===================================================

# CDN_PREFIX=/cdn
# ERROR_TITLE=Content unavailable
# ERROR_MESSAGE=The requested content is unavailable
